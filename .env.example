# ─────────────────────────────────────────────────────────────────────────────
# SpaceHub — environment variables
# Copy to .env.local for local development. On Vercel, set each variable per
# environment (Development / Preview / Production). Never commit real values.
#
# NEXT_PUBLIC_* values are shipped to the browser — NEVER put a secret in one.
# Everything else is server-only and validated with Zod at server start-up
# (src/lib/env.server.ts). On Vercel Preview/Production, missing required
# variables fail the deployment loudly instead of degrading silently.
#
# Locally, every service is optional: without Sanity the site uses demo seed
# content, without Supabase login/booking is disabled, etc.
# ─────────────────────────────────────────────────────────────────────────────

# Public site URL (no trailing slash). Used for Stripe return URLs, emails, sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Sanity (content + catalog) ──────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01
# Private dataset holding lean customer cards (name, email, join date, bookings count)
SANITY_CUSTOMERS_DATASET=customers
# Viewer token — read published content without CDN (pricing source of truth)
SANITY_API_READ_TOKEN=
# Editor token — seed script + customer-card sync. Separate from the read token.
SANITY_API_WRITE_TOKEN=
# Shared secret for the Sanity → /api/sanity/webhook signature (32+ random chars)
SANITY_WEBHOOK_SECRET=

# ── Supabase (auth, bookings, Postgres integrity) — region eu-central-1 ─────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Bypasses RLS — server only, never NEXT_PUBLIC
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (test mode) ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# ── Resend (transactional email) ────────────────────────────────────────────
RESEND_API_KEY=
# Test domain until a verified sending domain is configured
EMAIL_FROM=SpaceHub <onboarding@resend.dev>

# ── Telegram (staff notifications per branch) ───────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── Cloudflare Turnstile (bot protection on login + checkout) ───────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Upstash Redis (rate limiting; required on Vercel — fails closed) ────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Cron (pg_cron → /api/cron/maintenance). 32+ random chars. ───────────────
# Must equal the `spacehub_cron_secret` value stored in Supabase Vault.
CRON_SECRET=

# Signed auth-user webhook (Supabase trigger -> /api/auth/webhook). 32+ random chars.
# Must equal the `spacehub_auth_webhook_secret` value stored in Supabase Vault (0004_iam.sql).
AUTH_WEBHOOK_SECRET=

# Optional. Bearer token (40+ random chars) for the Google Sheets pull of /api/admin/bookings-export.
# Leave empty to allow staff-session downloads only.
CSV_EXPORT_TOKEN=

# Server Actions closure-encryption key (base64, 32 bytes): `openssl rand -base64 32`.
# Keeps action IDs/closures valid across instances and redeploys; rotate by redeploying with a new value.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# ── Google Analytics 4 (optional). Format G-XXXXXXXX. Loads only after the visitor consents. ──
NEXT_PUBLIC_GA4_ID=

# ── Sentry ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only (source map upload). Optional.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
